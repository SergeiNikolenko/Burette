  "extensionCoverageGaps": {
    "bcif": {
      "extensions": ["bcif"],
      "reason": "Need a compact BinaryCIF fixture."
    },
    "mmtf": {
      "extensions": ["mmtf"],
      "reason": "Need a compact MMTF fixture."
    },
    "xyzrender-input": {
      "extensions": ["fhiaims", "gms", "log", "out", "xyzr"],
      "reason": "Quantum/input alias coverage has representative xyzrender-compatible fixtures but not every alias."
    },
    "molecular-dynamics": {
      "extensions": [
        "arc",
        "config",
        "coor",
        "crdbox",
        "data",
        "dcd",
        "dump",
