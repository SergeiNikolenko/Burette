        "psf",
        "tng",
        "top",
        "tpr",
        "trc",
        "trr",
        "trz",
        "txyz",
        "xtc"
      ],
      "reason": "Trajectory/topology aliases need small paired fixtures and expected pairing metadata."
    },
    "schrodinger": {
      "extensions": ["cms"],
      "reason": "Schrodinger coverage has .mae/.maegz/.mae.gz fixtures; CMS still needs a compact redistributable sample."
    },
    "openmm-workflow-text-artifact": {
      "extensions": ["checkpoint", "chk", "dms", "edr", "fdef", "key", "par", "prm", "rtf", "str", "xvg"],
      "reason": "Need representative workflow text/metadata fixtures."
    }
