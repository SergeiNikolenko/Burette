;; A loader contract fixture, independent of libmsym/spglib. No toolchain or network at test time.
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_seek" (func $seek (param i32 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $sizes (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $get (param i32 i32) (result i32)))
  (import "env" "emscripten_notify_memory_growth" (func $growth (param i32)))
  (memory (export "memory") 1)
  ;; iovec at 0 addresses the six bytes at 64; environment outputs begin nonzero.
  (data (i32.const 0) "\40\00\00\00\06\00\00\00")
  (data (i32.const 12) "\ff\ff\ff\ff\ff\ff\ff\ff")
  (data (i32.const 64) "ready\0a")
  (func (export "_initialize")
    (i32.store (i32.const 24) (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))
    (i32.store (i32.const 28) (call $write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 20)))
    (i32.store (i32.const 32) (call $write (i32.const 3) (i32.const 0) (i32.const 1) (i32.const 36)))
    (i32.store (i32.const 40) (call $close (i32.const 7)))
    (i32.store (i32.const 44) (call $seek (i32.const 7) (i64.const 0) (i32.const 0) (i32.const 48)))
    (i32.store (i32.const 52) (call $sizes (i32.const 12) (i32.const 16)))
    (i32.store (i32.const 56) (call $get (i32.const 0) (i32.const 0)))
    (call $growth (i32.const 0)))
  (func (export "emit")
    (drop (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))))
