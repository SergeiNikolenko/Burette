      "viewer": { "molstarFormat": "xyz", "binary": false, "externalOnly": true },
      "preview": {
        "strategy": "convert",
        "renderer": "molstar",
        "primary": { "role": "structure", "format": "pdb", "binary": false },
        "converter": { "id": "maestro-to-pdb", "required": true },
        "staged": [
          {
            "role": "solvent",
            "format": "pdb",
            "representation": "solvent-lines",
            "requiredForReady": true
          }
        ],
        "fallbacks": [
          { "renderer": "xyzrender-external" }
        ],
        "capabilities": { "canSwitchRenderer": true, "hasStagedEntries": true }
      },
      "quickLook": { "sizeLimitMiB": 64 }
