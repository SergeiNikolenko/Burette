      "id": "molecular-dynamics",
      "contentType": "com.local.burrete10.molecular-dynamics",
      "extensions": ["xtc", "trr", "dcd", "nctraj", "lammpstrj", "top", "psf", "prmtop"],
      "conformsTo": ["public.data"],
      "description": "Molecular dynamics trajectory or topology file",
      "preview": {
        "strategy": "trajectory",
        "renderer": "molstar",
        "formats": {
          "coordinatesBinary": ["xtc", "trr", "dcd", "nctraj"],
          "coordinatesText": ["lammpstrj"],
          "topologyText": ["top", "psf", "prmtop"]
        },
        "capabilities": { "hasTrajectoryControls": true }
      },
      "quickLook": {
        "sizeLimitMiB": 25,
        "extensionSizeLimitMiB": {
          "xtc": 75,
          "trr": 75,
          "dcd": 75,
          "nctraj": 75
        }
      }
    },
    {
      "id": "schrodinger",
      "contentType": "com.local.burrete10.schrodinger",
      "contentTypeAliases": ["com.schrodinger.mae"],
      "extensions": ["mae", "mae.gz", "maegz", "cms"],
