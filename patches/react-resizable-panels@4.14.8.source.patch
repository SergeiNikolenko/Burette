--- /dev/null
+++ b/lib/global/utils/getExpandedItemSize.ts
@@ -0,0 +1,15 @@
+import type { RegisteredResizeAxis } from "../types";
+
+export function getExpandedItemSize(
+  axis: RegisteredResizeAxis,
+  itemId: string,
+  axisSize: number
+) {
+  const cached = axis.mutableState.expandedItemSizes[itemId];
+  if (!cached) return undefined;
+  const item = axis.items.find((item) => item.id === itemId);
+  return item?.constraintProps.groupResizeBehavior === "preserve-pixel-size" &&
+    axisSize > 0
+    ? (cached.size * cached.axisSize) / axisSize
+    : cached.size;
+}
