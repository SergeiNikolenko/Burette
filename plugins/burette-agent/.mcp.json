{
  "mcpServers": {
    "burette_agent_mcp": {
      "title": "Burette Agent MCP",
      "description": "Typed tools and bounded review surfaces for Burette molecular workspaces.",
      "icons": [
        {
          "src": "./assets/composer-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "32x32"
          ]
        },
        {
          "src": "./assets/app-icon.png",
          "mimeType": "image/png",
          "sizes": [
            "512x512"
          ]
        }
      ],
      "cwd": ".",
      "command": "node",
      "args": [
        "--max-semi-space-size=1",
        "./mcp/lib/server-bundle.mjs",
        "--stdio"
      ]
    }
  }
}
