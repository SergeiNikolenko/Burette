{
  "schema": "burette_mvs_story_template.v1",
  "id": "docking-pose-comparison",
  "title": "Docking pose comparison",
  "summary": "Compare two positioned ligand poses against the same receptor with explicit score and uncertainty caveats.",
  "category": "docking",
  "scientificUse": "Use to explain pose geometry and method-specific ranking after docking outputs have been checked.",
  "variables": [
    {
      "name": "receptor_url",
      "description": "HTTPS URL or MVSX archive path for the receptor PDB.",
      "required": true,
      "example": "receptor.pdb",
      "maxLength": 4096
    },
    {
      "name": "pose_a_url",
      "description": "HTTPS URL or MVSX archive path for positioned pose A in SDF format.",
      "required": true,
      "example": "pose-a.sdf",
      "maxLength": 4096
    },
    {
      "name": "pose_b_url",
      "description": "HTTPS URL or MVSX archive path for positioned pose B in SDF format.",
      "required": true,
      "example": "pose-b.sdf",
      "maxLength": 4096
    },
    {
      "name": "comparison_label",
      "description": "Short name for the comparison.",
      "required": false,
      "default": "Docking pose comparison",
      "example": "Top two GNINA poses",
      "maxLength": 256
    }
  ],
  "storyboard": [
    {
      "key": "receptor",
      "purpose": "Orient the receptor before comparing candidates.",
      "evidence": "Record receptor preparation and docking box provenance."
    },
    {
      "key": "pose-a",
      "purpose": "Inspect pose A independently.",
      "evidence": "Report only method-specific scores and computed contacts."
    },
    {
      "key": "pose-b",
      "purpose": "Inspect pose B with the same visual encoding.",
      "evidence": "Use the same receptor and representation to avoid presentation bias."
    },
    {
      "key": "comparison",
      "purpose": "Overlay both poses and state the decision with uncertainty.",
      "evidence": "Separate geometric observations, scoring outputs, and experimental claims."
    }
  ],
  "caveats": [
    "Docking scores are method-specific ranking signals, not measured binding affinities.",
    "The template does not compute contacts, clashes, strain, or pose confidence.",
    "Use identical receptor coordinates and visual encodings for a fair comparison."
  ],
  "story": {
    "title": "{{comparison_label}}",
    "description": "Reusable two-pose docking narrative with evidence boundaries.",
    "steps": [
      {
        "key": "receptor",
        "title": "Receptor context",
        "description": "# Receptor context\n\nRecord receptor preparation, docking box, and method provenance before comparing poses.",
        "root": {
          "kind": "root",
          "children": [
            {
              "kind": "download",
              "params": { "url": "{{receptor_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "pdb" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "polymer" },
                          "children": [
                            {
                              "kind": "representation",
                              "params": { "type": "cartoon" },
                              "children": [
                                { "kind": "color", "params": { "color": "#4E79A7" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "key": "pose-a",
        "title": "Pose A",
        "description": "# Pose A\n\nAdd the score field name, value, units where applicable, method status, and coordinate-derived contacts. Do not call the score an experimental affinity.",
        "root": {
          "kind": "root",
          "children": [
            {
              "kind": "download",
              "params": { "url": "{{receptor_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "pdb" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "polymer" },
                          "children": [
                            {
                              "kind": "representation",
                              "params": { "type": "cartoon" },
                              "children": [
                                { "kind": "color", "params": { "color": "#A9B7C8" } },
                                { "kind": "opacity", "params": { "opacity": 0.35 } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "download",
              "params": { "url": "{{pose_a_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "sdf" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "all" },
                          "children": [
                            { "kind": "focus", "params": {} },
                            {
                              "kind": "representation",
                              "params": { "type": "ball_and_stick" },
                              "children": [
                                { "kind": "color", "params": { "color": "#F28E2B" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "key": "pose-b",
        "title": "Pose B",
        "description": "# Pose B\n\nUse the same camera logic and evidence fields as Pose A so the comparison is not visually biased.",
        "root": {
          "kind": "root",
          "children": [
            {
              "kind": "download",
              "params": { "url": "{{receptor_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "pdb" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "polymer" },
                          "children": [
                            {
                              "kind": "representation",
                              "params": { "type": "cartoon" },
                              "children": [
                                { "kind": "color", "params": { "color": "#A9B7C8" } },
                                { "kind": "opacity", "params": { "opacity": 0.35 } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "download",
              "params": { "url": "{{pose_b_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "sdf" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "all" },
                          "children": [
                            { "kind": "focus", "params": {} },
                            {
                              "kind": "representation",
                              "params": { "type": "ball_and_stick" },
                              "children": [
                                { "kind": "color", "params": { "color": "#59A14F" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "key": "comparison",
        "title": "Pose overlay and decision",
        "description": "# Pose overlay and decision\n\nOrange is Pose A; green is Pose B. State geometry, method-specific scores, clashes or contacts from explicit calculations, uncertainty, and the next validation step separately.",
        "root": {
          "kind": "root",
          "children": [
            {
              "kind": "download",
              "params": { "url": "{{receptor_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "pdb" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "polymer" },
                          "children": [
                            {
                              "kind": "representation",
                              "params": { "type": "cartoon" },
                              "children": [
                                { "kind": "color", "params": { "color": "#A9B7C8" } },
                                { "kind": "opacity", "params": { "opacity": 0.25 } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "download",
              "params": { "url": "{{pose_a_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "sdf" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "all" },
                          "children": [
                            { "kind": "focus", "params": {} },
                            {
                              "kind": "representation",
                              "params": { "type": "ball_and_stick" },
                              "children": [
                                { "kind": "color", "params": { "color": "#F28E2B" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "kind": "download",
              "params": { "url": "{{pose_b_url}}" },
              "children": [
                {
                  "kind": "parse",
                  "params": { "format": "sdf" },
                  "children": [
                    {
                      "kind": "structure",
                      "params": { "type": "model" },
                      "children": [
                        {
                          "kind": "component",
                          "params": { "selector": "all" },
                          "children": [
                            {
                              "kind": "representation",
                              "params": { "type": "ball_and_stick" },
                              "children": [
                                { "kind": "color", "params": { "color": "#59A14F" } }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
