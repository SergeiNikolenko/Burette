{
  "name": "@burette/public-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:molstar": "node scripts/build-molstar-csp.mjs",
    "assets:viewer": "node scripts/build-hosted-viewer.mjs && bun run assets:molstar",
    "dev": "bun run assets:viewer && next dev",
    "build": "bun run assets:viewer && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun run assets:viewer && bun test tests"
  },
  "dependencies": {
    "@burette/ketcher-agent-contract": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@vercel/analytics": "2.0.1",
    "molstar": "5.11.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@modelcontextprotocol/server": "^2.1.0",
    "@modelcontextprotocol/core": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "~7.0.2"
  }
}
