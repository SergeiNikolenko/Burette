{
  "name": "@burrete/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config vite.config.ts --host 127.0.0.1",
    "build": "../../node_modules/.bin/vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "dev:tauri": "bunx --bun tauri dev",
    "build:tauri": "bun run build && node ../../node_modules/@tauri-apps/cli/tauri.js build",
    "tauri": "bunx --bun tauri"
  },
  "dependencies": {
    "@burrete/ketcher-agent-contract": "workspace:*",
    "ketcher-core": "3.15.0",
    "ketcher-react": "3.15.0",
    "ketcher-standalone": "3.15.0"
  }
}
