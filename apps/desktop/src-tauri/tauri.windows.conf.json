{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": null
  },
  "bundle": {
    "targets": ["nsis"],
    "shortDescription": "Molecular structure viewer",
    "longDescription": "Burette opens protein structures, small molecules, trajectories, volumes and chemical tables in one workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../compute/metal/runtime": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
