{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burrete",
  "version": "1.0.2",
  "identifier": "com.local.BurreteV10",
  "build": {
    "beforeDevCommand": "bun run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "true",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Burrete",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 29
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        },
        "decorations": true,
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "visible": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https://api.github.com asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; img-src 'self' data: asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; worker-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "resources": {
      "../../../PreviewExtension/Web": "ViewerWeb",
      "../../../scripts/desmond_preview_extract.py": "desmond_preview_extract.py"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false
    },
    "fileAssociations": [
      {
        "ext": [
          "abi",
          "arc",
          "bcif",
          "cif",
          "cms",
          "com",
          "config",
          "coor",
          "crdbox",
          "csv",
          "cub",
          "cube",
          "data",
          "dcd",
          "dms",
          "dump",
          "edr",
          "ent",
          "fasta",
          "fdf",
          "fhiaims",
          "gms",
          "graphml",
          "gro",
          "gsd",
          "h5md",
          "history",
          "in",
          "inp",
          "inpcrd",
          "itp",
          "lammpstrj",
          "lammps",
          "lmp",
          "log",
          "mae",
          "mae.gz",
          "maegz",
          "magma",
          "mcif",
          "mdcrd",
          "mgf",
          "mmcif",
          "mmtf",
          "mol",
          "mol2",
          "ms",
          "msp",
          "mvsj",
          "mvsx",
          "mzml",
          "mzxml",
          "namdbin",
          "nc",
          "ncdf",
          "ncrst",
          "nctraj",
          "netcdf",
          "nw",
          "out",
          "par",
          "parm",
          "parm7",
          "pdb",
          "pdbqt",
          "pqr",
          "prm",
          "prmtop",
          "psf",
          "psi4",
          "qcin",
          "restrt",
          "rst",
          "rst7",
          "rtf",
          "sd",
          "sdf",
          "smi",
          "smiles",
          "state",
          "str",
          "top",
          "tpr",
          "tng",
          "trc",
          "trj",
          "trr",
          "trz",
          "tsv",
          "txyz",
          "vasp",
          "xtc",
          "xml",
          "xpdb",
          "xvg",
          "xyz",
          "xyzr",
          "key",
          "chk",
          "checkpoint",
          "crd"
        ],
        "role": "Viewer"
      },
      {
        "ext": [
          "md",
          "markdown",
          "mdx",
          "txt",
          "log",
          "err",
          "sh",
          "bash",
          "zsh",
          "par",
          "prm",
          "rtf",
          "str",
          "key",
          "chk",
          "checkpoint"
        ],
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
