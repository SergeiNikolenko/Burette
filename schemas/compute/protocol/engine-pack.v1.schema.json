{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burette.app/schemas/compute/protocol/engine-pack.v1.schema.json",
  "title": "Burette EnginePackManifest cluster.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "enginePackId",
    "enginePackSha256",
    "workflowTemplate",
    "molecularSnapshot",
    "engineId",
    "engineVersion",
    "normalizedSettingsSha256",
    "layout",
    "createdAtMs"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "cluster.engine-pack.v1"
    },
    "enginePackId": {
      "$ref": "common.v1.schema.json#/$defs/nonNilUuid"
    },
    "enginePackSha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "workflowTemplate": {
      "const": "cluster.v1"
    },
    "molecularSnapshot": {
      "$ref": "molecular-snapshot.v1.schema.json#/$defs/molecularSnapshotRef"
    },
    "engineId": {
      "$ref": "common.v1.schema.json#/$defs/cleanLabel160"
    },
    "engineVersion": {
      "$ref": "common.v1.schema.json#/$defs/cleanLabel160"
    },
    "normalizedSettingsSha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "layout": {
      "allOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/packedLayout"
        },
        {
          "type": "object",
          "properties": {
            "arrays": {
              "type": "array",
              "contains": {
                "type": "object",
                "required": [
                  "name",
                  "semantic",
                  "unit",
                  "dtype",
                  "shape",
                  "byteOrder",
                  "alignment"
                ],
                "properties": {
                  "name": { "const": "fingerprints" },
                  "semantic": { "const": "morgan_fingerprint_bits" },
                  "unit": { "type": "null" },
                  "dtype": { "const": "u64" },
                  "shape": {
                    "type": "array",
                    "prefixItems": [
                      { "$ref": "common.v1.schema.json#/$defs/jsonSafeUInt" },
                      { "const": 32 }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "byteOrder": { "const": "littleEndian" },
                  "alignment": { "type": "integer", "minimum": 8 }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        }
      ]
    },
    "createdAtMs": {
      "$ref": "common.v1.schema.json#/$defs/jsonSafeUInt"
    }
  },
  "$defs": {
    "enginePackRef": {
      "type": "object",
      "required": [
        "schemaVersion",
        "enginePackId",
        "enginePackSha256",
        "workflowTemplate",
        "snapshotId",
        "snapshotSha256",
        "engineId",
        "engineVersion",
        "normalizedSettingsSha256",
        "manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "cluster.engine-pack.v1"
        },
        "enginePackId": {
          "$ref": "common.v1.schema.json#/$defs/nonNilUuid"
        },
        "enginePackSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "workflowTemplate": {
          "const": "cluster.v1"
        },
        "snapshotId": {
          "$ref": "common.v1.schema.json#/$defs/nonNilUuid"
        },
        "snapshotSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "engineId": {
          "$ref": "common.v1.schema.json#/$defs/cleanLabel160"
        },
        "engineVersion": {
          "$ref": "common.v1.schema.json#/$defs/cleanLabel160"
        },
        "normalizedSettingsSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "manifest": {
          "$ref": "common.v1.schema.json#/$defs/manifestFileDescriptor"
        }
      }
    }
  }
}
