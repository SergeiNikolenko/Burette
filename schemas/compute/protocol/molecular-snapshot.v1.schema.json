{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burette.app/schemas/compute/protocol/molecular-snapshot.v1.schema.json",
  "title": "Burette MolecularSnapshotManifest v1",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "snapshotSha256", "frozenSource", "layout", "createdAtMs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "burette.molecular-snapshot.v1"
    },
    "snapshotId": {
      "$ref": "common.v1.schema.json#/$defs/nonNilUuid"
    },
    "snapshotSha256": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "frozenSource": {
      "$ref": "#/$defs/frozenSourceIdentity"
    },
    "layout": {
      "$ref": "#/$defs/molecularSnapshotLayout"
    },
    "createdAtMs": {
      "$ref": "common.v1.schema.json#/$defs/jsonSafeUInt"
    }
  },
  "$defs": {
    "frozenSourceIdentity": {
      "type": "object",
      "required": [
        "documentFingerprintSha256",
        "sourceRevision",
        "recordCount",
        "orderedRecordMoleculeIdentitySha256"
      ],
      "additionalProperties": false,
      "properties": {
        "documentFingerprintSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "sourceRevision": {
          "$ref": "common.v1.schema.json#/$defs/positiveJsonSafeUInt"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "orderedRecordMoleculeIdentitySha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "molecularSnapshotRef": {
      "type": "object",
      "required": ["schemaVersion", "snapshotId", "snapshotSha256", "frozenSource", "manifest"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "burette.molecular-snapshot.v1"
        },
        "snapshotId": {
          "$ref": "common.v1.schema.json#/$defs/nonNilUuid"
        },
        "snapshotSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "frozenSource": {
          "$ref": "#/$defs/frozenSourceIdentity"
        },
        "manifest": {
          "$ref": "common.v1.schema.json#/$defs/manifestFileDescriptor"
        }
      }
    },
    "sourceRecordIdsArray": {
      "allOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/packedArrayDescriptor"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "sourceRecordIds"
            },
            "semantic": {
              "const": "source_record_id"
            },
            "unit": {
              "type": "null"
            },
            "dtype": {
              "const": "u64"
            },
            "shape": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "common.v1.schema.json#/$defs/positiveJsonSafeUInt"
              }
            }
          }
        }
      ]
    },
    "moleculeContentHashesArray": {
      "allOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/packedArrayDescriptor"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "const": "moleculeContentHashes"
            },
            "semantic": {
              "const": "molecule_content_sha256"
            },
            "unit": {
              "type": "null"
            },
            "dtype": {
              "const": "u8"
            },
            "shape": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "$ref": "common.v1.schema.json#/$defs/positiveJsonSafeUInt"
                },
                {
                  "const": 32
                }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "molecularRecordsFile": {
      "allOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/packedFileDescriptor"
        },
        {
          "type": "object",
          "properties": {
            "relativePath": {
              "const": "pack/molecular-records.v1.jsonl"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "mediaType": {
              "const": "application/vnd.burette.molecular-records-v1+jsonl"
            }
          }
        }
      ]
    },
    "molecularSnapshotLayout": {
      "allOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/packedLayout"
        },
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "contains": {
                "$ref": "#/$defs/molecularRecordsFile"
              },
              "minContains": 1,
              "maxContains": 1
            },
            "arrays": {
              "type": "array",
              "allOf": [
                {
                  "type": "array",
                  "contains": {
                    "$ref": "#/$defs/sourceRecordIdsArray"
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "type": "array",
                  "contains": {
                    "$ref": "#/$defs/moleculeContentHashesArray"
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      ]
    }
  }
}
